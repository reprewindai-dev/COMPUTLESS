# COMPUTLESS → AWS Lambda settings. Template only; the real files are written by
# cloud/aws-lambda/deploy.sh and must never be committed or pasted into chat.
#
# Two files, on purpose:
#   computless-aws.env          no secrets; these three values identify the function and role
#   computless-aws.secrets.env  the access key (only when the server runs outside AWS); mode 600
#
# ── computless-aws.env ───────────────────────────────────────────────────────
# Stack output "FunctionArn". Its region is also used if AWS_REGION is unset.
COMPUTLESS_AWS_FUNCTION_ARN=arn:aws:lambda:<region>:<12-digit account>:function:computless-runner-js
# Stack output "DispatcherRoleArn". COMPUTLESS assumes this role for every run;
# it can do nothing except invoke the function above.
COMPUTLESS_AWS_ROLE_ARN=arn:aws:iam::<12-digit account>:role/<stack>-DispatcherRole-<suffix>
AWS_REGION=<region, e.g. us-east-1>

# ── computless-aws.secrets.env (server outside AWS only) ─────────────────────
# The bootstrap user's key. Its only permission is sts:AssumeRole on the role above.
# Leave both unset when the server runs on AWS with its own IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
