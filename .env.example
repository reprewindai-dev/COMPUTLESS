# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Veklom fabric ─────────────────────────────────────────────────────────────
# Public URL of this COMPUTLESS deployment. Used as base_url in the cAPI
# registration and protocol.json. Without it, capabilities register as
# declared-only (not executable) in cAPI.
COMPUTLESS_PUBLIC_URL=

# cAPI registry (register + heartbeat). Key is sent as "Authorization: Bearer".
CAPI_BACKEND_URL=
CAPI_API_KEY=
# CAPI_REGISTRY_TTL_MS=300000

# CAPPO fail-closed authorization (POST /api/v1/execution/authorize, X-API-Key).
CAPPO_BACKEND_URL=
CAPPO_API_KEY=

# Gnomledger / PGL evidence (POST /api/v1/ledger/events, x-api-key).
# PGL_AGENT_ID must be an agent already registered in Gnomledger.
PGL_LEDGER_URL=
PGL_API_KEY=
PGL_AGENT_ID=

# Lockerphycer (reachability + protocol identity probe only).
LOCKERPHYCER_URL=

# disabled | local-demo | governed
# Default: governed when CAPPO_BACKEND_URL is set; otherwise disabled in
# production (NODE_ENV=production) and local-demo in development.
# COMPUTLESS_EXECUTION_MODE=

# Optional: commit SHA of the running build, reported in /api/fabric/status.
# COMPUTLESS_SOURCE_COMMIT=
